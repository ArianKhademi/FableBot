__pycache__/
*.pyc
.pytest_cache/
# macOS Finder metadata — Finder recreates it in every folder you open; a bare
# pattern ignores .DS_Store at any depth (root, data/, everywhere)
.DS_Store
state/
state_experiment*/
reports/
logs/
.venv/
venv/
# downloaded market data (e.g. WRDS/CRSP CSVs) — keep the tickers list tracked
data/*.csv
# generated proposals scratch — regenerated by the pipeline, not worth committing
analysis/latest_proposals.md
# secrets (PAT for the nightly reviewer); keep tokens out of git entirely
.env
secrets.env
